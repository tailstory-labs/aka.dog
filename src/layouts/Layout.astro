---
import { Font } from "astro:assets";

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}
const { title, description = "", noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const SITE_NAME = "aka.dog";
const documentTitle =
  title === SITE_NAME ? SITE_NAME : `${title} - ${SITE_NAME}`;

const path = Astro.url.pathname;
const nav = [
  {
    label: "All links",
    href: "/index",
    current: path.startsWith("/index"),
  },
  {
    label: "Look up",
    href: "/introspect",
    current: path.startsWith("/introspect"),
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{documentTitle}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta name="generator" content={Astro.generator} />
    <Font cssVariable="--font-sans" preload />
    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-mono" />
  </head>
  <body>
    <header class="site">
      <a class="wordmark" href="/">aka.dog</a>
      <nav aria-label="Site">
        {
          nav.map((item) => (
            <a href={item.href} aria-current={item.current ? "page" : undefined}>
              {item.label}
            </a>
          ))
        }
      </nav>
      <code class="build">{__GIT_COMMIT_HASH__}</code>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>

<style>
  .site {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.5rem;
    max-width: var(--page);
    margin: 0 auto;
    padding: 1.25rem var(--gutter);
  }
  .site a {
    text-decoration: none;
  }
  .wordmark {
    font: 800 1.375rem / 1 var(--font-display);
    letter-spacing: -0.04em;
    margin-right: auto;
  }
  nav {
    display: flex;
    gap: 0.25rem;
  }
  nav a {
    padding: 0.375rem 0.75rem;
    border-radius: 999px;
    color: var(--muted);
    font-size: var(--step--1);
    font-weight: 500;
  }
  nav a:hover {
    color: var(--foreground);
  }
  nav a[aria-current="page"] {
    background: var(--surface-2);
    color: var(--foreground);
  }
  .build {
    color: var(--muted);
    font-size: var(--step--2);
  }
</style>

<style is:global>
  :root {
    color-scheme: light dark;
    /* Tailstory's ink and paper. */
    --foreground: light-dark(#0b0e17, #f3f5fa);
    --background: light-dark(#f5f7fb, #0b0e17);
    --card: light-dark(#ffffff, #151925);
    --muted: color-mix(in srgb, var(--foreground) 62%, var(--background));
    --link-line: color-mix(in srgb, var(--foreground) 35%, var(--background));
    --rule: color-mix(in srgb, var(--foreground) 12%, var(--background));
    --surface: color-mix(in srgb, var(--foreground) 4%, var(--background));
    --surface-2: color-mix(in srgb, var(--foreground) 8%, var(--background));
    --surface-3: color-mix(in srgb, var(--foreground) 14%, var(--background));
    --accent: light-dark(#2447d8, #9db4ff);
    --warn-bg: light-dark(#fbe9c8, #3a2b12);
    --warn-fg: light-dark(#7a4a05, #f2c27a);
    --step--2: 0.75rem;
    --step--1: 0.875rem;
    --step-0: 1rem;
    --step-1: 1.1875rem;
    --step-2: 1.75rem;
    --step-3: 2.75rem;
    --radius: 0.875rem;
    --page: 64rem;
    --gutter: 1.5rem;
  }
  /* A component's own display must never un-hide a hidden element. */
  [hidden] {
    display: none !important;
  }
  body {
    margin: 0;
    background: var(--background);
    color: var(--foreground);
    font: var(--step-0) / 1.5 var(--font-sans);
  }
  a {
    color: inherit;
    text-decoration: underline 1px var(--link-line);
    text-underline-offset: 3px;
  }
  a:hover {
    text-decoration-color: var(--foreground);
  }
  :focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  code,
  kbd {
    font-family: var(--font-mono);
    font-size: 0.875em;
    overflow-wrap: anywhere;
  }
  main {
    max-width: var(--page);
    margin: 0 auto;
    padding: 2.5rem var(--gutter) 3rem;
    min-height: 60vh;
  }
  ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.35rem;
  }
  h1 {
    font: 800 var(--step-3) / 1.05 var(--font-display);
    letter-spacing: -0.04em;
    margin: 0 0 1.25rem;
  }
  h2 {
    font: 700 var(--step-1) / 1.2 var(--font-display);
    letter-spacing: -0.02em;
    margin: 0 0 0.75rem;
  }
  .lede {
    color: var(--muted);
    font-size: var(--step-1);
    margin: -0.5rem 0 1.75rem;
    max-width: 40rem;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    color: var(--muted);
    font-size: var(--step--1);
    margin-top: 2rem;
  }
  .muted {
    color: var(--muted);
  }
  .secondary {
    display: block;
    color: var(--muted);
    font-size: var(--step--1);
  }
  .group {
    margin-top: 2.5rem;
  }

  /* Tables sit on a card, so a long list reads as one object. */
  .table-card {
    background: var(--card);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    overflow: clip;
  }
  .table {
    width: 100%;
    border-collapse: collapse;
  }
  .table th,
  .table td {
    text-align: left;
    vertical-align: baseline;
    padding: 0.75rem 1.5rem 0.75rem 0;
    border-bottom: 1px solid var(--rule);
  }
  .table tbody tr:last-child :is(th, td),
  .table tbody tr:has(+ tr[hidden]:last-child) :is(th, td) {
    border-bottom: 0;
  }
  .table :is(th, td):first-child {
    padding-left: 1.125rem;
  }
  .table :is(th, td):last-child {
    padding-right: 1.125rem;
  }
  .table thead th {
    position: sticky;
    top: 0;
    z-index: 1;
    background: var(--card);
    font-weight: 500;
    font-size: var(--step--2);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .table tbody th {
    font-weight: 400;
    color: var(--muted);
    width: 9rem;
  }
  .table tbody tr:hover {
    background: var(--surface);
  }
  .table td.muted {
    font-size: var(--step--1);
  }

  .chip {
    display: inline-block;
    font-size: var(--step--2);
    line-height: 1.375rem;
    padding: 0 0.5625rem;
    border-radius: 999px;
    background: var(--surface-2);
    color: var(--muted);
    text-decoration: none;
    white-space: nowrap;
    vertical-align: 0.1em;
  }
  a.chip {
    color: var(--foreground);
    font-family: var(--font-mono);
  }
  a.chip:hover {
    background: var(--surface-3);
  }
  .chip--warn {
    background: var(--warn-bg);
    color: var(--warn-fg);
    font-weight: 600;
  }

  .cards {
    grid-template-columns: repeat(auto-fill, minmax(min(18rem, 100%), 1fr));
    gap: 0.75rem;
    margin: 0;
  }
  .card {
    display: flex;
    flex-direction: column;
    height: 100%;
    box-sizing: border-box;
    padding: 1rem 1.125rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--card);
    text-decoration: none;
    transition:
      border-color 0.12s,
      box-shadow 0.12s;
  }
  a.card:is(:hover, :focus-visible) {
    border-color: var(--foreground);
    box-shadow: 0 2px 0 var(--foreground);
  }
  .card .name {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem;
    font-weight: 600;
  }
  .card .go {
    color: var(--link-line);
    font-weight: 400;
  }
  .card:is(:hover, :focus-visible) .go {
    color: var(--accent);
  }
  .card .blurb {
    color: var(--muted);
    font-size: var(--step--1);
  }
  .card .host {
    margin-top: auto;
    padding-top: 0.75rem;
    color: var(--muted);
    font-size: var(--step--2);
  }

  /* The one text field shape: home search, table filter, look up. */
  .field {
    width: 100%;
    box-sizing: border-box;
    font: inherit;
    color: inherit;
    background: var(--card);
    border: 1.5px solid var(--foreground);
    border-radius: var(--radius);
    padding: 0.75rem 1rem;
  }
  .field::placeholder {
    color: var(--muted);
  }
  .field:focus-visible {
    outline-offset: 1px;
  }

  @media (min-width: 40.0625rem) {
    .table {
      table-layout: fixed;
    }
    .table col {
      width: var(--w, auto);
    }
  }

  @media (max-width: 40rem) {
    :root {
      --gutter: 1rem;
      --step-3: 2.125rem;
    }
    main {
      padding-top: 1.5rem;
    }
    .shed {
      display: none;
    }
    .card {
      padding: 0.75rem 1rem;
    }
    .card .host {
      padding-top: 0.25rem;
    }
    .table tbody th {
      width: 6rem;
    }
  }
</style>
