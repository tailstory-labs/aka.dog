---
import { Font } from "astro:assets";

export interface Crumb {
  label: string;
  href?: string | undefined;
}

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  crumbs?: Crumb[];
}
const { title, description = "", noindex = false, crumbs = [] } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const SITE_NAME = "aka.dog";
const documentTitle =
  title === SITE_NAME ? SITE_NAME : `${title} - ${SITE_NAME}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{documentTitle}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta name="generator" content={Astro.generator} />
    <Font cssVariable="--font-sans" preload />
    <Font cssVariable="--font-mono" />
  </head>
  <body>
    <main>
      {
        crumbs.length > 0 && (
          <nav aria-label="Breadcrumb" class="crumbs">
            {crumbs.map((crumb, index) => (
              <>
                {index > 0 && <span aria-hidden="true"> / </span>}
                {crumb.href ? (
                  <a href={crumb.href}>{crumb.label}</a>
                ) : (
                  <span aria-current="page">{crumb.label}</span>
                )}
              </>
            ))}
          </nav>
        )
      }
      <slot />
    </main>
  </body>
</html>

<style>
  .crumbs {
    color: var(--muted);
    font-size: var(--step--1);
    margin-bottom: 0.4rem;
  }
  /* The first crumb is the site itself - the one way home, as there is no
     header. */
  .crumbs > a:first-child {
    color: var(--foreground);
    font-weight: 600;
  }
</style>

<style is:global>
  /* Only tokens and what more than one component uses live here; a style one
     component needs is scoped in that component. */
  :root {
    color-scheme: light dark;
    --foreground: light-dark(#16161a, #ededef);
    --background: light-dark(#fbfbfa, #0e0e10);
    /* Every other neutral is mixed from those two, so the themes can't drift
       apart and nothing needs a second hex value. --muted keeps 4.5:1 even on
       --surface-2; --link-line is ~2.5:1 - stronger than --rule, because an
       underline is the only thing marking a link, far quieter than text. */
    --muted: color-mix(in srgb, var(--foreground) 65%, var(--background));
    --link-line: color-mix(in srgb, var(--foreground) 40%, var(--background));
    --rule: color-mix(in srgb, var(--foreground) 10%, var(--background));
    /* Flat fills stand in for borders, a step darker on hover. */
    --surface: color-mix(in srgb, var(--foreground) 5%, var(--background));
    --surface-2: color-mix(in srgb, var(--foreground) 9%, var(--background));
    --surface-3: color-mix(in srgb, var(--foreground) 14%, var(--background));
    --accent: light-dark(#2f55d4, #9db8ff);
    /* Status, not decoration: only a dead address or a retired entry is
       tinted, so the colour always means the same thing. */
    --warn-bg: light-dark(#f7e8ce, #3a2b12);
    --warn-fg: light-dark(#7a4f0e, #f2c27a);
    --step--2: 0.75rem;
    --step--1: 0.875rem;
    --step-0: 0.9375rem;
    --step-1: 1.125rem;
    --step-2: 1.75rem;
    --step-3: 2.5rem;
    --radius: 0.75rem;
  }
  body {
    margin: 0;
    background: var(--background);
    color: var(--foreground);
    font: var(--step-0) / 1.5 var(--font-sans);
  }
  /* Flat links: no colour of their own, marked by a hairline underline that
     firms up on hover. `color: inherit` is what makes one rule work
     everywhere - a link in a muted cell stays muted, one in an address cell
     stays full strength - and it beats the UA :link/:visited colours by
     cascade origin, so the blue and the purple both go. */
  a {
    color: inherit;
    text-decoration: underline 1px var(--link-line);
    text-underline-offset: 3px;
  }
  a:hover {
    text-decoration-color: var(--foreground);
  }
  /* Not optional: with colour gone, this is all a keyboard user has left. */
  :focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  code,
  kbd {
    font-family: var(--font-mono);
    font-size: 0.875em;
    /* [tenant]-my.sharepoint.com must not blow out a fixed-width cell */
    overflow-wrap: anywhere;
  }
  main {
    /* One column for every page, so the left edge never jumps between them.
       Wide enough that no current address wraps in a table and the card grid
       holds three columns; measured against the longest host in the dataset
       (m365.cloud.microsoft/launch/sharepoint). */
    max-width: 65rem;
    margin: 0 auto;
    padding: 4.5rem 1.5rem 4rem;
  }
  main p {
    max-width: 45rem;
  }
  ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.35rem;
  }
  h1 {
    font-size: var(--step-3);
    line-height: 1.1;
    font-weight: 600;
    letter-spacing: -0.03em;
    margin: 0 0 0.5rem;
  }
  h2 {
    font-size: var(--step-0);
    font-weight: 600;
    margin: 0 0 0.5rem;
  }
  .lede {
    color: var(--muted);
    font-size: var(--step-1);
    margin: 0 0 1.75rem;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    color: var(--muted);
    font-size: var(--step--1);
    margin-top: 3rem;
  }
  .muted {
    color: var(--muted);
  }
  .secondary {
    display: block;
    color: var(--muted);
    font-size: var(--step--1);
  }
  .group {
    margin-top: 2.5rem;
  }

  .table {
    width: 100%;
    border-collapse: collapse;
  }
  .table th,
  .table td {
    text-align: left;
    vertical-align: baseline;
    padding: 0.625rem 1.5rem 0.625rem 0;
    border-bottom: 1px solid var(--rule);
  }
  /* The inset lets the hover fill reach past the text without the text
     moving off the column edge. */
  .table :is(th, td):first-child {
    padding-left: 0.5rem;
  }
  .table :is(th, td):last-child {
    padding-right: 0.5rem;
  }
  /* A headerless table (the introspect facts) still opens on a rule. */
  .table:not(:has(thead)) {
    border-top: 1px solid var(--rule);
  }
  .table thead th {
    position: sticky;
    top: 0;
    background: var(--background);
    font-weight: 500;
    font-size: var(--step--1);
    color: var(--muted);
  }
  .table tbody th {
    font-weight: 400;
    color: var(--muted);
    width: 10rem;
  }
  .table tbody tr:hover {
    background: var(--surface);
  }
  .table td.muted {
    font-size: var(--step--1);
  }

  /* A static pill (a tag, where an address was found) reads muted; a pill
     that is a link reads at full strength, in the mono face of an address. */
  .chip {
    display: inline-block;
    font-size: var(--step--2);
    line-height: 1.375rem;
    padding: 0 0.5625rem;
    border-radius: 999px;
    background: var(--surface-2);
    color: var(--muted);
    text-decoration: none;
    white-space: nowrap;
    vertical-align: 0.1em;
  }
  a.chip {
    color: var(--foreground);
    font-family: var(--font-mono);
  }
  a.chip:hover {
    background: var(--surface-3);
  }
  .chip--warn {
    background: var(--warn-bg);
    color: var(--warn-fg);
    font-weight: 600;
  }

  .cards {
    /* The floor, not the container width, is what stops addresses wrapping:
       auto-fill spends extra width on more columns, not wider ones. min()
       clamps it on narrow phones so a card can never overflow the screen. */
    grid-template-columns: repeat(auto-fill, minmax(min(19rem, 100%), 1fr));
    gap: 0.625rem;
    margin: 0;
  }
  .card {
    /* Column flex so the address can sit at the bottom: grid rows stretch to
       the tallest card, and without this a one-line blurb leaves its address
       stranded mid-card while its neighbour's sits lower. */
    display: flex;
    flex-direction: column;
    height: 100%;
    box-sizing: border-box;
    padding: 1rem 1.125rem;
    border-radius: var(--radius);
    background: var(--surface);
    /* A linked card is one target; the fill that deepens on hover and the
       arrow that appears are what mark it, so no underline anywhere on it. */
    text-decoration: none;
  }
  a.card:hover {
    background: var(--surface-2);
  }
  .card .name {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem;
    font-weight: 600;
  }
  .card .go {
    color: var(--accent);
    font-size: var(--step--1);
    font-weight: 400;
    opacity: 0;
  }
  .card:is(:hover, :focus-visible) .go {
    opacity: 1;
  }
  .card .blurb {
    color: var(--muted);
    font-size: var(--step--1);
  }
  .card .host {
    margin-top: auto;
    padding-top: 0.75rem;
    color: var(--muted);
    font-size: var(--step--2);
  }

  @media (min-width: 40.0625rem) {
    /* Fixed layout is what actually keeps the columns aligned: without it the
       longest description dictates the column width for every row. Each table
       sets its widths on its <col>s as --w; below the breakpoint - where
       columns are shed - they're ignored and the table reflows to fill the
       screen instead of holding empty tracks open. */
    .table {
      table-layout: fixed;
    }
    .table col {
      width: var(--w, auto);
    }
  }

  @media (max-width: 40rem) {
    main {
      padding: 2rem 1rem 3rem;
    }
    h1 {
      font-size: 2rem;
    }
    /* Shed columns rather than scroll sideways - the table stays a table, so
       it stays navigable for assistive tech. Header and cells both carry it. */
    .shed {
      display: none;
    }
    .table tbody th {
      width: 6.5rem;
    }
  }
</style>
