---
import EntryTable from "@/components/EntryTable.astro";
import TableFilter from "@/components/TableFilter.astro";
import Layout from "@/layouts/Layout.astro";
import { resolveViewByPath } from "@/lib/views";

const view = resolveViewByPath([]);
const lastVerified = view.entries
  .map((entry) => entry.last_verified)
  .filter(Boolean)
  .sort()
  .pop();
---

<Layout
  title={view.title}
  description={view.description}
  width="wide"
  crumbs={[{ label: 'aka.dog', href: '/' }, { label: 'index' }]}
>
  <h1>{view.title}</h1>
  <p class="lede">{view.description} - {view.entries.length} entries</p>

  <TableFilter label="Filter entries" />
  <EntryTable entries={view.entries} showProvider />

  <p class="meta">
    {lastVerified && <>Addresses last verified {lastVerified}{' · '}</>}
    <a href="/index.json">JSON</a>
    {' · '}
    <a href="/index/deprecated">deprecated addresses</a>
    {' · '}
    <a href="/index/links">short links</a>
  </p>
</Layout>
