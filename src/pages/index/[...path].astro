---
import CuratedGroups from "@/components/CuratedGroups.astro";
import DeprecationTable from "@/components/DeprecationTable.astro";
import EntryTable from "@/components/EntryTable.astro";
import LinkTable from "@/components/LinkTable.astro";
import TableFilter from "@/components/TableFilter.astro";
import Layout from "@/layouts/Layout.astro";
import { counted, providerName } from "@/lib/format";
import {
  deprecationRows,
  lastVerified,
  providerNav,
  type ResolvedView,
  resolveViewByPath,
} from "@/lib/views";

// Every /index page, the cross-provider dump at /index included (no segments).
const segments = (Astro.params.path ?? "").split("/").filter(Boolean);
let resolved: ResolvedView;
try {
  resolved = resolveViewByPath(segments);
} catch {
  return new Response("Not found", {
    status: 404,
    headers: { "content-type": "text/plain" },
  });
}
const view = resolved;

const [provider, subview] = segments;

const verified = lastVerified(view.entries);
const rows = view.kind === "deprecated" ? deprecationRows(view.entries) : [];

// Every view of one provider, so its pages can be switched between in place.
// The first segment is not always a provider - /index/deprecated and
// /index/links land here too - so the tabs key off the nav, not the segment.
// The tabs already name the provider, so the heading drops the "Microsoft: "
// prefix the title carries; the <title> keeps it.
const nav = providerNav().find((group) => group.provider === provider);
const tabs = (
  nav
    ? [
        { label: "All", slug: "" },
        ...nav.collections.map(({ slug, title }) => ({ label: title, slug })),
        { label: "Moved", slug: "deprecated" },
      ].map(({ label, slug }) => ({
        label,
        href: slug
          ? `/index/${nav.provider}/${slug}`
          : `/index/${nav.provider}`,
      }))
    : [
        { label: "All", href: "/index" },
        { label: "Moved", href: "/index/deprecated" },
        { label: "Short links", href: "/index/links" },
      ]
).map((tab) => ({ ...tab, current: tab.href === Astro.url.pathname }));
const heading =
  nav && subview ? view.title.slice(nav.provider.length + 2) : view.title;
const jsonHref = `${Astro.url.pathname}.json`;
---

<Layout title={view.title} description={view.description}>
  {nav && subview && <p class="eyebrow">{providerName(nav.provider)}</p>}
  <h1>{heading}</h1>
  <nav aria-label="Views" class="tabs">
    {
      tabs.map((tab) => (
        <a href={tab.href} aria-current={tab.current ? "page" : undefined}>
          {tab.label}
        </a>
      ))
    }
  </nav>

  {
    view.kind === 'curated' ? (
      <CuratedGroups lead={view.lead} groups={view.groups} />
    ) : view.kind === 'deprecated' ? (
      <>
        <TableFilter label={`Search ${counted('old address', 'old addresses', rows.length)}`} />
        <DeprecationTable rows={rows} />
      </>
    ) : view.kind === 'links' ? (
      view.links.length === 0 ? (
        <p class="muted">Nothing here yet</p>
      ) : (
        <>
          <TableFilter label="Search short links" />
          <LinkTable links={view.links} />
        </>
      )
    ) : view.entries.length === 0 ? (
      <p class="muted">Nothing here yet</p>
    ) : (
      <>
        <TableFilter label={`Search ${counted('link', 'links', view.entries.length)}`} />
        <EntryTable entries={view.entries} showProvider={!provider} />
      </>
    )
  }

  <p class="meta">
    {verified && <span>Checked {verified}</span>}
    <a href={jsonHref}>JSON</a>
    <a href="https://github.com/tailstory/aka.dog/issues/new/choose">Report a link</a>
  </p>
</Layout>

<style>
  .eyebrow {
    margin: 0 0 0.25rem;
    color: var(--muted);
    font-weight: 500;
  }
  .tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    margin: 0 0 1.5rem;
    font-size: var(--step--1);
  }
  .tabs a {
    padding: 0.375rem 0.875rem;
    border-radius: 999px;
    border: 1px solid var(--rule);
    color: var(--muted);
    font-weight: 500;
    text-decoration: none;
  }
  .tabs a:hover {
    color: var(--foreground);
  }
  .tabs a[aria-current="page"] {
    background: var(--foreground);
    border-color: var(--foreground);
    color: var(--background);
  }
</style>
