---
import CuratedGroups from "@/components/CuratedGroups.astro";
import DeprecationTable from "@/components/DeprecationTable.astro";
import EntryTable from "@/components/EntryTable.astro";
import LinkTable from "@/components/LinkTable.astro";
import TableFilter from "@/components/TableFilter.astro";
import Layout, { type Crumb } from "@/layouts/Layout.astro";
import {
  deprecationRows,
  type ResolvedView,
  resolveViewByPath,
} from "@/lib/views";

const segments = (Astro.params.path ?? "").split("/").filter(Boolean);
let resolved: ResolvedView;
try {
  resolved = resolveViewByPath(segments);
} catch {
  return new Response("Not found", {
    status: 404,
    headers: { "content-type": "text/plain" },
  });
}
const view = resolved;

const [provider, subview] = segments;
const crumbs: Crumb[] = [
  { label: "aka.dog", href: "/" },
  { label: "index", href: "/index" },
];
if (provider)
  crumbs.push(
    subview
      ? { label: provider, href: `/index/${provider}` }
      : { label: provider },
  );
if (subview) crumbs.push({ label: subview });

const lastVerified = view.entries
  .map((entry) => entry.last_verified)
  .filter(Boolean)
  .sort()
  .pop();
const rows = view.kind === "deprecated" ? deprecationRows(view.entries) : [];
---

<Layout
  title={view.title}
  description={view.description}
  width="wide"
  crumbs={crumbs}
>
  <h1>{view.title}</h1>
  <p class="lede">{view.description}</p>

  {
    view.kind === 'curated' ? (
      <CuratedGroups lead={view.lead} groups={view.groups} />
    ) : view.kind === 'deprecated' ? (
      <>
        <TableFilter label="Filter addresses" />
        <DeprecationTable rows={rows} />
      </>
    ) : view.kind === 'links' ? (
      view.links.length === 0 ? (
        <p>Nothing here yet</p>
      ) : (
        <>
          <TableFilter label="Filter short links" />
          <LinkTable links={view.links} />
        </>
      )
    ) : view.entries.length === 0 ? (
      <p>Nothing here yet</p>
    ) : (
      <>
        <TableFilter label="Filter entries" />
        <EntryTable entries={view.entries} />
      </>
    )
  }

  <p class="meta">
    {lastVerified && <>Addresses last verified {lastVerified}{' · '}</>}
    <a href={`${Astro.url.pathname}.json`}>JSON</a>
    {
      view.kind === 'curated' && (
        <>
          {' · '}
          <a href={`/index/${provider}`}>every {provider} address</a>
        </>
      )
    }
    {
      /* Dead addresses are only listed on the deprecated view now, so every
         other view points at it rather than reprinting one. The links view is
         the exception: a short link is not an address and has no history, so
         there is nothing for it to point at. */
      view.kind !== 'deprecated' &&
        view.kind !== 'links' && (
        <>
          {' · '}
          <a href={provider ? `/index/${provider}/deprecated` : '/index/deprecated'}>
            deprecated addresses
          </a>
        </>
      )
    }
  </p>
</Layout>
