---
import CuratedGroups from "@/components/CuratedGroups.astro";
import HomeSearch from "@/components/HomeSearch.astro";
import Layout from "@/layouts/Layout.astro";
import { curatedPages } from "@/lib/curated";
import { entries } from "@/lib/entries";
import { counted, providerName } from "@/lib/format";
import { deprecationRows, resolveViewByPath } from "@/lib/views";

const examples = ["outlook", "password reset", "office.com"];

// Each provider's curated pages, in full: the home page is the links people
// came for, not a menu of pages that hold them.
const sections = curatedPages.flatMap((page) => {
  const view = resolveViewByPath([page.provider, page.slug]);
  if (view.kind !== "curated") return [];
  const scoped = entries.filter((entry) => entry.provider === page.provider);
  return [
    {
      provider: page.provider,
      view,
      all: scoped.length,
      moved: deprecationRows(scoped).filter((row) => row.url).length,
    },
  ];
});
---

<Layout
  title="aka.dog"
  description="Current addresses for Microsoft 365 apps, and where the old ones went."
>
  <section class="hero">
    <h1>Where did that link&nbsp;go?</h1>
    <p class="lede">Current Microsoft 365 addresses, and where the old ones went.</p>
    <HomeSearch />
    <p class="examples">
      <span class="muted">Try</span>
      {
        examples.map((example) => (
          <button type="button" class="chip" data-example={example}>
            {example}
          </button>
        ))
      }
    </p>
  </section>

  {
    sections.map(({ provider, view, all, moved }) => (
      <section class="provider">
        <CuratedGroups lead={view.lead} groups={view.groups} />
        <p class="rest">
          <a href={`/index/${provider}`}>
            All {counted("link", "links", all)} for {providerName(provider)}
          </a>
          <a href={`/index/${provider}/deprecated`}>
            {counted("moved address", "moved addresses", moved)}
          </a>
        </p>
      </section>
    ))
  }
</Layout>

<script>
  const input = document.getElementById("home-search") as HTMLInputElement | null;
  for (const chip of document.querySelectorAll<HTMLElement>("[data-example]"))
    chip.addEventListener("click", () => {
      if (!input) return;
      input.value = chip.dataset.example ?? "";
      input.dispatchEvent(new Event("input"));
      input.focus();
    });
</script>

<style>
  /* Room above the field for Bailey to peek over it. */
  .hero {
    padding: 2rem 0 1rem;
  }
  h1 {
    font-size: clamp(2.5rem, 7vw, 4.25rem);
    margin-bottom: 1rem;
  }
  .lede {
    margin: 0 0 4.5rem;
  }
  .examples {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin: 1rem 0 0;
    font-size: var(--step--1);
  }
  .examples .chip {
    border: 0;
    cursor: pointer;
    font-family: var(--font-mono);
    color: var(--foreground);
  }
  .examples .chip:hover {
    background: var(--surface-3);
  }
  .provider {
    margin-top: 3rem;
  }
  .rest {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin: 2.5rem 0 0;
    font-weight: 500;
  }
</style>
