---
import Layout from "@/layouts/Layout.astro";
import { entries } from "@/lib/entries";
import { counted, plural } from "@/lib/format";
import { shortLinks } from "@/lib/redirects";
import { deprecationRows, providerNav } from "@/lib/views";

// Counted from the data, never written down: each is what the page it links
// to lists.
const formerAddresses = deprecationRows(entries).filter((row) => row.url);
const stats = [
  {
    href: "/index",
    count: entries.length,
    label: plural("entry", "entries", entries.length),
    blurb: "The full index, one row per service",
  },
  {
    href: "/index/deprecated",
    count: formerAddresses.length,
    label: plural("former address", "former addresses", formerAddresses.length),
    blurb: "Old hosts, and what each one became",
  },
  {
    href: "/index/links",
    count: shortLinks.length,
    label: plural("short link", "short links", shortLinks.length),
    code: "aka.dog/{who}/{slug}",
    blurb: "302s onward",
  },
];

const namespaces = providerNav().map(({ provider, collections }) => ({
  provider,
  collections,
  size: entries.filter((entry) => entry.provider === provider).length,
}));
---

<Layout
  title="aka.dog"
  description="A derived reference index of vendor cloud and service endpoints across namespaces (and a link shortener)."
>
  <a href="/" class="wordmark" aria-current="page">aka.dog</a>
  <h1>Where vendors’ services actually live.</h1>
  <p class="lede">
    Current endpoints, their old hosts, and what moved where, organized by namespace. Entries are the
    source of truth; every page is a derived view.
  </p>

  <p class="examples">
    <span class="muted"><a href="/introspect">Introspect</a> any link, like</span>
    <a class="chip" href="/introspect/office.com">office.com</a>
    <a class="chip" href="/introspect/aka.ms/copilot">aka.ms/copilot</a>
    <a class="chip" href="/introspect/shenanigans/resume">shenanigans/resume</a>
  </p>

  <ul class="cards stats">
    {
      stats.map((stat) => (
        <li>
          <a class="card" href={stat.href}>
            <span class="figure">{stat.count}</span>
            <span class="name">{stat.label}</span>
            <span class="blurb">
              {stat.code && <><code>{stat.code}</code> </>}
              {stat.blurb}
            </span>
          </a>
        </li>
      ))
    }
  </ul>

  <section class="group">
    <h2>Namespaces</h2>
    <table class="table">
      <colgroup>
        <col style="--w: 11rem" />
        <col />
        <col style="--w: 7rem" />
      </colgroup>
      <tbody>
        {
          namespaces.map(({ provider, collections, size }) => (
            <tr>
              <td>
                <a class="provider" href={`/index/${provider}`}>{provider}</a>
              </td>
              <td class="muted">
                <span class="views">
                  {collections.map((collection) => (
                    <a href={`/index/${provider}/${collection.slug}`}>
                      {collection.title}
                    </a>
                  ))}
                  <a href={`/index/${provider}/deprecated`}>deprecated</a>
                </span>
              </td>
              <td class="muted size">{counted('entry', 'entries', size)}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </section>

  <p class="footnote">Append <code>.json</code> to any page for the machine-readable view.</p>
</Layout>

<style>
  .wordmark {
    font-weight: 700;
    font-size: var(--step-1);
    letter-spacing: -0.02em;
    text-decoration: none;
  }
  h1 {
    margin-top: 1.25rem;
  }
  .examples {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.625rem;
    font-size: var(--step--1);
  }
  .examples a:not(.chip) {
    color: var(--foreground);
  }
  .stats {
    margin-top: 2.5rem;
  }
  .figure {
    font-size: var(--step-2);
    line-height: 1.2;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .provider {
    font-weight: 600;
  }
  .views {
    display: flex;
    flex-wrap: wrap;
    column-gap: 1.25rem;
  }
  .size {
    text-align: right;
  }
  .footnote {
    margin-top: 3rem;
    color: var(--muted);
    font-size: var(--step--1);
  }
</style>
