---
import Layout from "@/layouts/Layout.astro";
import { providerNav } from "@/lib/views";

const navigation = providerNav();
---

<Layout
  title="aka.dog"
  description="A derived reference index of vendor cloud and service endpoints across namespaces (and a link shortener)."
>
  <h1>aka.dog</h1>
  <p>
    A small reference index of where vendors' services actually live - current endpoints, their old
    hosts, and what moved where, organized by namespace. Entries are the source of truth; every page
    is a derived view.
  </p>
  <p>
    Start at the <a href="/index">full index</a>, browse the <a href="/index/deprecated">deprecated</a> list,
    or jump to a namespace below. Append <code>.json</code> to any of these for the machine-readable
    view.
  </p>
  <p>
    Got a URL and want to know what's tracked about it?
    <a href="/introspect">Introspect</a> it - any index address or short link, straight in the
    path - try <a href="/introspect/office.com"><code>office.com</code></a>.
  </p>
  <p>
    aka.dog is a shortener too - <code>aka.dog/&#123;who&#125;/&#123;slug&#125;</code> <code>302</code>s
    onward. See <a href="/index/links">every short link it serves</a>.
  </p>
  <ul>
    {
      navigation.map((providerGroup) => (
        <li>
          <a href={`/index/${providerGroup.provider}`}>{providerGroup.provider}</a>
          {providerGroup.collections.length ? (
            <small>
              {' - '}
              {providerGroup.collections.map((collection, index) => (
                <>
                  {index > 0 ? ', ' : ''}
                  <a href={`/index/${providerGroup.provider}/${collection.slug}`}>
                    {collection.title}
                  </a>
                </>
              ))}
            </small>
          ) : null}
        </li>
      ))
    }
  </ul>
</Layout>
