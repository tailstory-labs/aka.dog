---
import HomeSearch from "@/components/HomeSearch.astro";
import Layout from "@/layouts/Layout.astro";
import { curatedPagesFor } from "@/lib/curated";
import { entries } from "@/lib/entries";
import { counted, providerName } from "@/lib/format";
import { providers, resolveViewByPath } from "@/lib/views";

const examples = ["outlook", "password reset", "office.com"];
const NAMED = 6;

// One card per vendor. It names the apps people come for: the vendor's curated
// page when it has one, else its first entries.
const vendors = providers().map((provider) => {
  const scoped = entries.filter((entry) => entry.provider === provider);
  const [curated] = curatedPagesFor(provider);
  const view = curated && resolveViewByPath([provider, curated.slug]);
  const names =
    view?.kind === "curated"
      ? [
          ...(view.lead ? [view.lead] : []),
          ...view.groups.flatMap((group) => group.items),
        ].map((item) => item.label)
      : scoped.map((entry) => entry.name);
  return {
    provider,
    href: curated ? `/index/${provider}/${curated.slug}` : `/index/${provider}`,
    names: names.slice(0, NAMED),
    size: scoped.length,
  };
});
---

<Layout
  title="aka.dog"
  description="Current addresses for the apps you use at work, and where the old ones went."
>
  <section class="hero">
    <h1>Where did that link&nbsp;go?</h1>
    <p class="lede">
      Current addresses for the apps you use at work, and where the old ones went.
    </p>
    <HomeSearch />
    <p class="examples">
      <span class="muted">Try</span>
      {
        examples.map((example) => (
          <button type="button" class="chip" data-example={example}>
            {example}
          </button>
        ))
      }
    </p>
  </section>

  <ul class="vendors">
    {
      vendors.map(({ provider, href, names, size }) => (
        <li>
          <a class="card vendor" href={href}>
            <span class="name">
              {providerName(provider)}
              <span class="go" aria-hidden="true">→</span>
            </span>
            <span class="apps">{names.join(", ")}</span>
            <span class="size">{counted("link", "links", size)}</span>
          </a>
        </li>
      ))
    }
  </ul>
</Layout>

<script>
  const input = document.getElementById("home-search") as HTMLInputElement | null;
  for (const chip of document.querySelectorAll<HTMLElement>("[data-example]"))
    chip.addEventListener("click", () => {
      if (!input) return;
      input.value = chip.dataset.example ?? "";
      input.dispatchEvent(new Event("input"));
      input.focus();
    });
</script>

<style>
  /* Room above the field for Bailey to peek over it. */
  .hero {
    padding: 2rem 0 1rem;
  }
  h1 {
    font-size: clamp(2.5rem, 7vw, 4.25rem);
    margin-bottom: 1rem;
  }
  .lede {
    margin: 0 0 4.5rem;
  }
  .examples {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin: 1rem 0 0;
    font-size: var(--step--1);
  }
  .examples .chip {
    border: 0;
    cursor: pointer;
    font-family: var(--font-mono);
    color: var(--foreground);
  }
  .examples .chip:hover {
    background: var(--surface-3);
  }
  .vendors {
    grid-template-columns: repeat(auto-fill, minmax(min(19rem, 100%), 1fr));
    gap: 0.875rem;
    margin: 3rem 0 0;
  }
  .vendor {
    gap: 0.625rem;
    padding: 1.375rem 1.5rem;
  }
  .vendor .name {
    font: 800 var(--step-2) / 1.1 var(--font-display);
    letter-spacing: -0.035em;
  }
  .vendor .go {
    font: 400 1.25rem var(--font-sans);
  }
  .apps {
    color: var(--muted);
  }
  .size {
    margin-top: auto;
    padding-top: 0.5rem;
    color: var(--muted);
    font-size: var(--step--1);
  }
</style>
