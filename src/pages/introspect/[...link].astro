---
import AddressFacts from "@/components/AddressFacts.astro";
import Host from "@/components/Host.astro";
import Layout from "@/layouts/Layout.astro";
import { entries } from "@/lib/entries";
import { counted } from "@/lib/format";
import {
  forDisplay,
  introspectPathname,
  WHERE_LABEL,
  type Where,
} from "@/lib/introspect";

// Unbounded input, so this is server-rendered rather than prerendered.
export const prerender = false;

// The look-up form posts here as ?link=, which works without scripts.
const asked = Astro.url.searchParams.get("link")?.trim();
if (asked)
  return Astro.redirect(
    `/introspect/${asked.replace(/^https?:\/\//i, "").replace(/^\/+|\/+$/g, "")}`,
  );

const result = introspectPathname(Astro.url.pathname);
// Set the status but still render the page: an unknown link deserves a helpful
// body, which is exactly what index/[...path].astro's bare `new Response("Not
// found")` cannot give.
if (result.kind === "unknown") Astro.response.status = 404;

const shown = forDisplay(result.link);
const jsonHref = `${Astro.url.pathname.replace(/\.json$/, "")}.json`;

const WHERE_LEDE: Record<Where, string> = {
  current: "Current address of",
  history: "Old address of",
  aka_ms: "Shortcut to",
  alternate: "Also works for",
};

const title = result.kind === "empty" ? "Look up a link" : shown;

// An address lookup names where the link was found beside the heading, and a
// former address also gets a Was -> Now at summary: the dead address muted and
// unlinked, its live successor beside it - what it became, else the entry's own
// live address, else its successor's.
const addressHit = result.kind === "address" ? result.hit : undefined;
const wasDead = addressHit?.match.where === "history";
// An address can move more than once, so follow it to where it rests today.
const latest = (url: string | undefined): string | undefined => {
  let at = url;
  for (let hop = 0; at && hop < 8; hop++) {
    const next = entries
      .flatMap((entry) => entry.history ?? [])
      .find((past) => past.url === at)?.became;
    if (!next) break;
    at = next;
  }
  return at;
};
const nowAt =
  addressHit && wasDead
    ? (latest(addressHit.match.became) ??
      addressHit.entry.primary ??
      addressHit.entry.successor?.primary)
    : undefined;

const description =
  result.kind === "empty"
    ? "Paste a link to see where it goes now."
    : `Where ${shown} goes now.`;
---

<Layout
  title={title}
  description={description}
  noindex={result.kind !== 'empty'}
>
  {
    result.kind === 'empty' ? (
      <>
        <h1>Look up a link</h1>
        <form class="lookup" action="/introspect">
          <input
            class="field"
            name="link"
            type="search"
            autocomplete="off"
            spellcheck="false"
            placeholder="office.com"
            aria-label="Link"
            required
          />
          <button type="submit">Look up</button>
        </form>
        <p class="examples">
          <span class="muted">Try</span>
          <a class="chip" href="/introspect/office.com">office.com</a>
          <a class="chip" href="/introspect/aka.ms/copilot">aka.ms/copilot</a>
          <a class="chip" href="/introspect/outlook.office.com">outlook.office.com</a>
        </p>
      </>
    ) : (
      <>
        <div class="title-row">
          <h1><Host url={shown} /></h1>
          {result.kind === 'redirect' && <span class="chip">short link</span>}
          {addressHit && (
            <span class:list={['chip', { 'chip--warn': wasDead }]}>
              {WHERE_LABEL[addressHit.match.where]}
            </span>
          )}
          <a class="json" href={jsonHref}>JSON</a>
        </div>

        {result.input !== result.link && (
          <p class="secondary">
            Read as <code>{shown}</code>
          </p>
        )}

        {result.via === 'www-stripped' && (
          <p class="secondary">
            No match on <code>{forDisplay(result.input)}</code>; showing{' '}
            <code>{shown}</code>.
          </p>
        )}

        {result.kind === 'redirect' && (
          <>
            <div class="card moved">
              <div>
                <span class="label">Short link</span>
                <Host url={`aka.dog/${result.link}`} />
              </div>
              <span class="arrow" aria-hidden="true">→</span>
              <div>
                <span class="label">Goes to</span>
                <a href={result.target}>
                  {result.targetLink ? (
                    <Host url={result.targetLink} />
                  ) : (
                    <code>{result.target}</code>
                  )}
                </a>
              </div>
            </div>

            {result.targetIsSelf && result.targetLink && (
              <p>
                <a href={`/introspect/${result.targetLink.replace(/^[^/]*\/?/, '')}`}>
                  Look that one up
                </a>
              </p>
            )}

            {result.targetHit && (
              <div class="group">
                <h2>Where it lands</h2>
                <AddressFacts hit={result.targetHit} />
              </div>
            )}

            {result.alsoIndexed && (
              <div class="group">
                <h2>Also an address</h2>
                <AddressFacts hit={result.alsoIndexed} />
              </div>
            )}
          </>
        )}

        {result.kind === 'address' && (
          <>
            <p class="lede">
              {WHERE_LEDE[result.hit.match.where]}{' '}
              <strong>{result.hit.entry.entry.name}</strong>
              {result.hit.entry.retired && ' (retired)'}
            </p>
            {nowAt && (
              <div class="card moved">
                <div>
                  <span class="label">Was</span>
                  <Host url={result.hit.match.url} class="muted" />
                </div>
                <span class="arrow" aria-hidden="true">→</span>
                <div>
                  <span class="label">Now at</span>
                  <a href={`https://${nowAt}`}>
                    <Host url={nowAt} />
                  </a>
                </div>
              </div>
            )}
            <AddressFacts hit={result.hit} hideAddress />
            {result.otherHits.length > 0 && (
              <div class="group">
                <h2>Also used by</h2>
                {result.otherHits.map((hit) => (
                  <AddressFacts hit={hit} />
                ))}
              </div>
            )}
          </>
        )}

        {result.kind === 'host' && (
          <>
            <p class="lede">
              No exact match. {counted('address', 'addresses', result.addresses.length)}{' '}
              under <code>{result.host}</code>:
            </p>
            <div class="table-card">
            <table class="table">
              <thead>
                <tr>
                  <th scope="col">Address</th>
                  <th scope="col">App</th>
                </tr>
              </thead>
              <tbody>
                {result.addresses.map((hit) => (
                  <tr>
                    <td>
                      <a href={`/introspect/${hit.match.url}`}>
                        <Host
                          url={hit.match.url}
                          class={hit.match.where === 'history' ? 'muted' : undefined}
                        />
                      </a>
                    </td>
                    <td>
                      <a href={`/index/${hit.entry.entry.provider}#entry-${hit.entry.entry.id}`}>
                        {hit.entry.entry.name}
                      </a>
                      {hit.match.where === 'history' && (
                        <> <span class="chip chip--warn">old</span></>
                      )}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
            </div>
          </>
        )}

        {result.kind === 'unknown' && (
          <>
            <p class="lede">Not on the list. It may still work.</p>
            <p class="actions">
              <a href="/index">All links</a>
              <a href="https://github.com/tailstory/aka.dog/issues/new/choose">
                Report it
              </a>
            </p>
          </>
        )}
      </>
    )
  }
</Layout>

<style>
  .lookup {
    display: flex;
    gap: 0.5rem;
    max-width: 36rem;
  }
  .lookup .field {
    font-family: var(--font-mono);
  }
  .lookup button {
    font: inherit;
    font-weight: 600;
    white-space: nowrap;
    padding: 0 1.25rem;
    border: 0;
    border-radius: var(--radius);
    background: var(--foreground);
    color: var(--background);
    cursor: pointer;
  }
  .examples,
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--step--1);
  }
  .actions {
    gap: 0.5rem 1.5rem;
    font-size: inherit;
    font-weight: 500;
  }
  .title-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: 0.875rem;
    margin-bottom: 1.25rem;
  }
  .json {
    margin-left: auto;
    color: var(--muted);
    font-size: var(--step--1);
  }
  .title-row h1 {
    margin: 0;
  }
  .title-row :global(code) {
    font-size: 0.8em;
    font-weight: 500;
    letter-spacing: -0.03em;
  }
  /* Was -> Now at: a card, laid out as two addresses and an arrow. */
  .moved {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    column-gap: 1.5rem;
    padding: 1.375rem 1.625rem;
    margin-bottom: 1.5rem;
    height: auto;
  }
  .moved :global(code) {
    font-size: var(--step-1);
  }
  .label {
    display: block;
    color: var(--muted);
    font-size: var(--step--1);
    font-weight: 500;
  }
  .arrow {
    color: var(--accent);
    font-size: var(--step-2);
  }
  @media (max-width: 40rem) {
    .moved {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 0.75rem;
    }
    .arrow {
      display: none;
    }
  }
</style>
