---
import Host from "@/components/Host.astro";
import type { ResolvedGroup, ResolvedItem } from "@/lib/views";

interface Props {
  lead?: ResolvedItem | undefined;
  groups: ResolvedGroup[];
}
const { lead, groups } = Astro.props;
---

{
  lead && (
    <a class="card lead" href={lead.href}>
      <span>
        <span class="name">{lead.label}</span>
        {lead.blurb && <span class="blurb">{lead.blurb}</span>}
      </span>
      <span class="host">
        <Host url={lead.url} /> <span class="go" aria-hidden="true">↗</span>
      </span>
    </a>
  )
}
{
  groups.map((group) => (
    <section class="group">
      <div class="head">
        <h2>{group.title}</h2>
        {group.note && <p class="muted">{group.note}</p>}
      </div>
      <ul class="cards">
        {group.items.map((item) => (
          <li>
            <a class="card" href={item.href}>
              <span class="name">
                {item.label}
                <span class="go" aria-hidden="true">↗</span>
              </span>
              {item.blurb && <span class="blurb">{item.blurb}</span>}
              <Host url={item.url} class="host" />
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))
}

<style>
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: 0.75rem;
    margin-bottom: 0.75rem;
  }
  .head > * {
    margin: 0;
  }
  /* The lead is the one card set larger, with its arrow always showing. */
  .lead {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    column-gap: 1.5rem;
    padding: 1.625rem 1.75rem;
  }
  .lead .name {
    font-size: var(--step-2);
    line-height: 1.2;
    letter-spacing: -0.02em;
  }
  .lead .blurb {
    display: block;
    font-size: var(--step-0);
  }
  .lead .host {
    padding: 0;
    font-size: var(--step--1);
  }
  .lead .host :global(code) {
    font-size: inherit;
  }
  .lead .go {
    opacity: 1;
  }
  @media (max-width: 40rem) {
    .lead {
      display: flex;
    }
    .lead .host {
      margin-top: 0.75rem;
    }
  }
</style>
