---
import Host from "@/components/Host.astro";
import type { ResolvedGroup, ResolvedItem } from "@/lib/views";

interface Props {
  lead?: ResolvedItem | undefined;
  groups: ResolvedGroup[];
}
const { lead, groups } = Astro.props;

const host = (href: string) => href.replace(/^https:\/\//, "");
---

{
  lead && (
    <p class="lead">
      <span class="name">{lead.label}</span>
      {lead.blurb && <span class="blurb">{lead.blurb}</span>}
      <a class="host" href={lead.href}>
        <Host url={host(lead.href)} />
      </a>
    </p>
  )
}
{
  groups.map((group) => (
    <section class="grp">
      <h2>{group.title}</h2>
      {group.note && <p class="grp-note">{group.note}</p>}
      <ul class="links">
        {group.items.map((item) => (
          <li>
            <span class="name">{item.label}</span>
            <span class="blurb">{item.blurb}</span>
            <a class="host" href={item.href}>
              <Host url={host(item.href)} />
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))
}
