---
import Host from "@/components/Host.astro";
import type { Entry } from "@/lib/types";

interface Props {
  entries: Entry[];
  /** Show the provider column (the cross-provider dump). */
  showProvider?: boolean;
}
const { entries, showProvider = false } = Astro.props;

const entriesById = new Map(entries.map((entry) => [entry.id, entry]));
const successorOf = (entry: Entry) =>
  entry.superseded_by ? entriesById.get(entry.superseded_by) : undefined;

// Past addresses stay in the search key even though no cell prints one: a
// reader who only remembers the old host still lands on the entry that
// replaced it, and the key is never rendered.
const searchKey = (entry: Entry) =>
  [
    entry.name,
    entry.provider,
    entry.description ?? "",
    ...(entry.current ?? []).map((address) => address.url),
    ...(entry.history ?? []).map((address) => address.url),
    ...(entry.aka_ms ?? []).map((pointer) => pointer.url),
    ...(entry.tags ?? []),
  ]
    .join(" ")
    .toLowerCase();

const columns = 2 + (showProvider ? 1 : 0) + 1;
---

<table
  class:list={['table', showProvider ? 'table--dump' : 'table--provider']}
  id="index-table"
>
  <colgroup>
    <col />
    <col />
    {showProvider && <col />}
    <col />
  </colgroup>
  <thead>
    <tr>
      <th scope="col">Name</th>
      <th scope="col">Address</th>
      {showProvider && <th scope="col" class="column-provider">Provider</th>}
      <th scope="col" class="column-notes">What it is</th>
    </tr>
  </thead>
  <tbody>
    {
      entries.map((entry) => {
        const current = entry.current ?? [];
        const primary = current[0];
        const successor = successorOf(entry);
        const pointers = entry.aka_ms ?? [];
        // A retired entry keeps its row - the entry is the durable thing, and
        // the deprecated table links back to this anchor - but its addresses
        // are all dead, and dead addresses are the deprecated view's job. An
        // em dash rather than a blank cell, as in DeprecationTable.
        const nothingLive =
          current.length === 0 && !successor && pointers.length === 0;
        return (
          <tr id={`entry-${entry.id}`} data-search={searchKey(entry)}>
            <td>
              <span>{entry.name}</span>
              {!primary && <> <span class="chip">retired</span></>}
            </td>
            <td>
              {current.map((address) => (
                <a class="stack" href={`https://${address.url}`}>
                  <Host url={address.url} />
                </a>
              ))}
              {nothingLive && <span>&#8212;</span>}
              {successor && (
                <span class="secondary">
                  {'→ '}
                  {successor.current?.[0] ? (
                    <a
                      href={`https://${successor.current[0].url}`}
                      title={successor.name}
                    >
                      <Host url={successor.current[0].url} />
                    </a>
                  ) : (
                    <span>{successor.name}</span>
                  )}
                </span>
              )}
              {pointers.length > 0 && (
                <span class="secondary">
                  {pointers.map((pointer) => (
                    <a
                      class="chip"
                      href={`https://${pointer.url}`}
                      title={pointer.label}
                    >
                      {pointer.url}
                    </a>
                  ))}
                </span>
              )}
            </td>
            {showProvider && (
              <td class="column-provider">
                <a href={`/index/${entry.provider}`}>{entry.provider}</a>
              </td>
            )}
            <td class="column-notes">{entry.description}</td>
          </tr>
        );
      })
    }
    <tr id="filter-empty" hidden>
      <td colspan={columns}>No matches.</td>
    </tr>
  </tbody>
</table>
