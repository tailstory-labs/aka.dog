---
import Host from "@/components/Host.astro";
import type { DeprecationRow } from "@/lib/views";

interface Props {
  rows: DeprecationRow[];
}
const { rows } = Astro.props;

const searchKey = (row: DeprecationRow) =>
  [row.entry.name, row.url ?? "", row.became ?? "", row.until ?? ""]
    .join(" ")
    .toLowerCase();
---

<table class="table" id="index-table">
  <colgroup>
    <col style="--w: 30%" />
    <col style="--w: 30%" />
    <col style="--w: 12%" />
    <col />
  </colgroup>
  <thead>
    <tr>
      <th scope="col">Was</th>
      <th scope="col">Became</th>
      <th scope="col" class="shed">Retired</th>
      <th scope="col" class="shed">Service</th>
    </tr>
  </thead>
  <tbody>
    {
      rows.map((row) => (
        <tr data-search={searchKey(row)}>
          <td>
            {/* Muted and unlinked, deliberately not struck through: struck
                small monospace is unreadable, and the column header already
                says "Was". */}
            {row.url ? <Host url={row.url} class="muted" /> : <span>&#8212;</span>}
          </td>
          <td>
            {row.became ? (
              <a href={`https://${row.became}`}>
                <Host url={row.became} />
              </a>
            ) : (
              <span class="chip chip--warn">retired</span>
            )}
          </td>
          <td class="muted shed">{row.until ?? ''}</td>
          <td class="muted shed">
            <a href={`/index/${row.entry.provider}#entry-${row.entry.id}`}>
              {row.entry.name}
            </a>
          </td>
        </tr>
      ))
    }
    <tr id="filter-empty" hidden>
      <td colspan="4">No matches.</td>
    </tr>
  </tbody>
</table>
