{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aka.dog/schemas/curated.json",
  "title": "CuratedPage",
  "description": "A hand-curated page: ordering, grouping and audience-specific wording over entries. Never restates an address that an entry already owns.",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "description", "groups"],
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "lead": {
      "$ref": "#/$defs/item",
      "description": "The one link this page exists to put in front of someone."
    },
    "groups": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/group" }
    }
  },

  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },

    "entryItem": {
      "title": "CuratedEntryItem",
      "type": "object",
      "additionalProperties": false,
      "required": ["entry"],
      "properties": {
        "entry": {
          "$ref": "#/$defs/slug",
          "description": "id of an entry in data/entries; the address is resolved from it"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "description": "short display name for this audience; defaults to the entry's name"
        },
        "blurb": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "one short phrase for this audience. Not entry.description, and never falls back to it."
        }
      }
    },

    "linkItem": {
      "title": "CuratedLinkItem",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 32 },
        "url": {
          "type": "string",
          "minLength": 1,
          "description": "bare host plus optional path, no scheme - matching the entry convention"
        },
        "blurb": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    },

    "item": {
      "title": "CuratedItem",
      "oneOf": [{ "$ref": "#/$defs/entryItem" }, { "$ref": "#/$defs/linkItem" }]
    },

    "group": {
      "title": "CuratedGroup",
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "items"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 48 },
        "note": { "type": "string", "maxLength": 120 },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/item" }
        }
      }
    }
  }
}
